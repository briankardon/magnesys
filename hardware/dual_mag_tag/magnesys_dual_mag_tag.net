    (libpart (lib "Connector") (part "Conn_01x02_Female")
      (description "Generic 2-pin connector")
      (pins (pin (num "1") (name "Pin_1") (type "passive"))
            (pin (num "2") (name "Pin_2") (type "passive"))))
    (libpart (lib "Connector_Generic") (part "Conn_01x08")
      (description "Generic 8-pin header used as TMR sensor placeholder")
      (pins (pin (num "1") (name "VCC")  (type "power_in"))
            (pin (num "2") (name "GND")  (type "power_in"))
            (pin (num "3") (name "X+")   (type "output"))
            (pin (num "4") (name "X-")   (type "output"))
            (pin (num "5") (name "Y+")   (type "output"))
            (pin (num "6") (name "Y-")   (type "output"))
            (pin (num "7") (name "Z+")   (type "output"))
            (pin (num "8") (name "Z-")   (type "output"))))
    (libpart (lib "Connector_Generic") (part "Conn_01x13")
      (description "Generic 13-pin header for nRF52832 module")
      (pins (pin (num "1")  (name "VCC")        (type "power_out"))
            (pin (num "2")  (name "GND")        (type "power_out"))
            (pin (num "3")  (name "P0.02_AIN0") (type "input"))
            (pin (num "4")  (name "P0.03_AIN1") (type "input"))
            (pin (num "5")  (name "P0.04_AIN2") (type "input"))
            (pin (num "6")  (name "P0.05_AIN3") (type "input"))
            (pin (num "7")  (name "P0.28_AIN4") (type "input"))
            (pin (num "8")  (name "P0.29_AIN5") (type "input"))
            (pin (num "9")  (name "P0.06_BTN")  (type "input"))
            (pin (num "10") (name "P0.07_LED")  (type "output"))
            (pin (num "11") (name "SWDIO")      (type "bidirectional"))
            (pin (num "12") (name "SWCLK")      (type "input"))
            (pin (num "13") (name "nRESET")     (type "input"))))
    (libpart (lib "Regulator_Linear") (part "MIC5219-3.3YM5")
      (description "3.3 V LDO, SOT-23-5")
      (pins (pin (num "1") (name "IN")     (type "power_in"))
            (pin (num "2") (name "GND")    (type "power_in"))
            (pin (num "3") (name "EN")     (type "input"))
            (pin (num "4") (name "BYPASS") (type "passive"))
            (pin (num "5") (name "OUT")    (type "power_out"))))
    (libpart (lib "Amplifier_Operational") (part "TLV9001IDBV")
      (description "Single-channel rail-to-rail op-amp, SOT-23-5")
      (pins (pin (num "1") (name "OUT") (type "output"))
            (pin (num "2") (name "V-")  (type "power_in"))
            (pin (num "3") (name "+IN") (type "input"))
            (pin (num "4") (name "-IN") (type "input"))
            (pin (num "5") (name "V+")  (type "power_in"))))
    (libpart (lib "Amplifier_Instrumentation") (part "AD8421")
      (description "Low-noise instrumentation amplifier")
      (pins (pin (num "1") (name "-IN") (type "input"))
            (pin (num "2") (name "RG1") (type "passive"))
            (pin (num "3") (name "RG2") (type "passive"))
            (pin (num "4") (name "+IN") (type "input"))
            (pin (num "5") (name "REF") (type "input"))
            (pin (num "6") (name "OUT") (type "output"))
            (pin (num "7") (name "V+")  (type "power_in"))
            (pin (num "8") (name "V-")  (type "power_in")))))

