# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environment
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Magnesys simulation files
*.json

# Experiment artifacts: CSV exports of B-vs-time / B-vs-position and
# their _inverted.csv counterparts. Already-tracked CSVs (e.g.
# demos/test_signal.csv) are unaffected by this rule.
demos/*.csv

# KiCad: autogenerated backups, caches, lock files, and per-user state
*-backups/
_autosave-*
~*.lck
\#auto_saved_files\#
fp-info-cache
*.kicad_prl

# Claude Code local state (scheduled tasks, project-specific settings)
.claude/
